# Server-only. Use the service-role key, never a browser publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy aliases: NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY.
# Required only to allow OAK Staff / Coordination Team participant registrations.
STAFF_ACCESS_CODE=
# Optional confirmation emails; registration works without email delivery.
RESEND_API_KEY=
EMAIL_FROM=

# Optional, used only by npm run db:migrate -- --apply (never exposed to the app).
SUPABASE_DB_URL=
